// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database
// declared below, writes the real database_id into your copy of the repo, and wires
// the repo to Workers Builds so every push to main redeploys automatically
// (build command: `npm run build`, deploy command: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-fortune-stick",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // Also served at app.manyfold.ai/fortune-stick (a route on the manyfold.ai zone,
  // shared with other apps). Forks: delete this block and BASE_PATH below; the
  // workers.dev URL keeps working at the root either way.
  "routes": [
    {
      "pattern": "app.manyfold.ai/fortune-stick*",
      "zone_name": "manyfold.ai"
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, plus the pages the Worker adds to on the way past: link previews
    // (src/worker/meta.ts) and the Google tag (src/worker/analytics.ts). Under
    // BASE_PATH everything wakes the Worker, because the prefix has to come off first.
    "run_worker_first": ["/", "/privacy", "/api/*", "/fortune-stick", "/fortune-stick/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-fortune-stick-db",
      "database_id": "911ece11-605c-4090-8610-f80c77841efd"
    }
  ],
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // Requests under this prefix are served as if they had arrived at the root.
    "BASE_PATH": "/fortune-stick",
    // Preview builds can override this to the matching Tarot preview URL.
    "TAROT_HANDOFF_URL": "https://app.manyfold.ai/tarot/",
    // Other Tarot hosts a visitor may have come from; the Tarot link sends them back there.
    "TAROT_RETURN_URLS": "https://tarot.manyfold.ai/",
    // GA4 measurement id for app.manyfold.ai/fortune-stick. Forks: clear it (or put your
    // own id here); empty means no analytics is served at all. Consent Mode v2 defaults
    // ship with the tag (src/worker/analytics.ts).
    "GA_MEASUREMENT_ID": "G-86RWKZYYJB"
  }
  // Optional hardening, neither is required to deploy:
  //   npx wrangler secret put ADMIN_PASSWORD          # protects agent management in /settings
  //   npx wrangler secret put CONFIG_ENCRYPTION_KEY   # >=32 chars; otherwise a key is generated and stored in D1
}
